{
	"name": "self-improve-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check": "biome check",
		"cs": "changeset",
		"fix": "biome check --write",
		"prepare": "node -e \"if(!(process.env.CI||process.env.GITHUB_ACTIONS))require('child_process').execSync('husky',{stdio:'inherit'})\"",
		"release": "changeset publish",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"plugin:build": "universal-plugin plugin build --root packages/self-improve && biome format --write packages/self-improve/plugin.json",
		"plugin:check": "node scripts/check-plugin-build.mjs",
		"plugin:validate": "universal-plugin plugin validate --root packages/self-improve",
		"verify": "pnpm check && pnpm plugin:check && pnpm plugin:validate && turbo run typecheck test",
		"version": "changeset version && universal-plugin plugin version --from-package --root packages/self-improve && pnpm plugin:build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.0",
		"@changesets/cli": "^3.0.3",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@repobuddy/biome": "^2.7.0",
		"husky": "^9.1.7",
		"turbo": "^2.11.7",
		"universal-plugin": "^0.23.1"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.16.1"
}
