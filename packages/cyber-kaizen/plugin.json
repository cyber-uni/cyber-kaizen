{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "cyber-kaizen",
	"version": "0.0.0",
	"description": "Agent self-improvement: a retrospective that turns what happened in use into lessons the owner approves.",
	"author": {
		"name": "unional"
	},
	"homepage": "https://github.com/cyber-uni/cyber-kaizen",
	"repository": "https://github.com/cyber-uni/cyber-kaizen",
	"license": "MIT",
	"keywords": ["retrospective", "self-improvement", "agent", "lessons", "productivity"],
	"extensions": {
		"org.cyberuni.universal-plugin": {
			"vendors": ["claude-code", "cursor", "codex", "copilot-cli"],
			"harnesses": {
				"cursor": {
					"category": "productivity",
					"tags": ["retrospective", "self-improvement"]
				},
				"codex": {
					"interface": {
						"displayName": "Cyber Kaizen",
						"category": "productivity"
					}
				}
			}
		}
	}
}
